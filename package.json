{
  "name": "ai-agent-detect",
  "version": "0.1.0",
  "description": "Detect which AI agent is running your code — structured identity (name, version, mode) with evidence, not just a boolean. Reads the AI_AGENT standard (both dialects) and the signals it misses.",
  "license": "MIT",
  "author": "George Mihailov",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "agents/",
    "fixtures/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bench.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai-agent",
    "AI_AGENT",
    "agent-detection",
    "detection",
    "isagent",
    "claude-code",
    "grok",
    "codex",
    "cursor",
    "gemini-cli",
    "amp",
    "goose",
    "opencode",
    "agentic"
  ]
}
